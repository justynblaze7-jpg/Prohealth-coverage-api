# Copy to .env for local testing. On Render, set these under Environment.

# Postgres connection string. On Render use the database's Internal Database URL.
DATABASE_URL=postgres://user:password@localhost:5432/prohealth_coverage

# Long random password for the staff dashboard (12+ characters).
STAFF_KEY=change-me-to-a-long-random-value

# Web addresses allowed to call the API from a browser, comma separated, no trailing slash.
ALLOWED_ORIGINS=https://prohealth-coverage-checker.vercel.app

# Optional
REPORT_TIMEZONE=Africa/Lagos
WRITE_LIMIT_PER_MIN=60
# DATABASE_SSL=true   # only when connecting to Render's External Database URL
